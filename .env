# StackSense — Umgebungsvariablen
# WICHTIG: Diese Datei niemals in Git committen!

# Backend URL
# Android Emulator: 10.0.2.2 = localhost des Entwicklungs-PCs
# Echtes Gerät: IP-Adresse deines PCs im selben WLAN
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Anthropic API Key (für direkten Flutter-Call während Dev — in Prod: nur Backend)
ANTHROPIC_API_KEY=dein-key-hier

# RevenueCat — Android Public SDK Key (RevenueCat-Dashboard → Projekt → API Keys).
# Leer lassen bis der RevenueCat-Account eingerichtet ist — echte Käufe bleiben
# dann deaktiviert, der kostenlose Test-Aufladeknopf funktioniert trotzdem weiter.
REVENUECAT_API_KEY_ANDROID=
